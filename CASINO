// FUNCIONES AUXILIARES ----------------------------------

function procesarApuesta(int $valorapuesta, int &$saldodisponible, string $apuesta): string {

    $aleatorio = rand(1,100);

    if ($valorapuesta > $saldodisponible) {

        return "El valor es mayor que su saldo actual.";

    } else if ($valorapuesta <= $saldodisponible) {

        if ($apuesta == "PAR" && $aleatorio % 2 == 0) {

            $saldodisponible += $valorapuesta;
            $msgresultado = "Has acertado.";

        } else if ($apuesta == "IMPAR" && $aleatorio % 2 == 1) {

            $saldodisponible += $valorapuesta;
            $msgresultado = "Has acertado.";

        } else {

            $saldodisponible -= $valorapuesta;
            $msgresultado = "Has fallado.";

        }

    }

    return $msgresultado;

}
