<?php

if ($_SERVER["REQUEST_METHOD"] == "POST") {

    // Recoger datos del formulario

    $nombre = htmlspecialchars(trim($_POST["nombre"]));
    $alias = htmlspecialchars(trim($_POST["alias"]));
    $edad = $_POST["edad"];

    $armas = $_POST["armas"] ?? [];

    $magia = $_POST["magia"] ?? "No";


    // Variables para la imagen

    $rutaImagen = "img/calavera.png";

    $mensajeError = "";

    $subidaCorrecta = false;


    /*
     * VALIDACIÓN DEL NOMBRE Y ALIAS
     */

    if ($nombre == "" || $alias == "") {

        $mensajeError = "El nombre y el alias son obligatorios.";

    }


    /*
     * COMPROBAR IMAGEN
     */

    if (isset($_FILES["imagen"]) && $_FILES["imagen"]["error"] != 4) {

        // Tamaño máximo: 10 KB

        $maxTam = 10000000;


        if ($_FILES["imagen"]["size"] > $maxTam) {

            $mensajeError = "Error: la imagen supera los 10 KB.";

        } else {

            // Tipos permitidos

            $permitidos = [
                "image/jpeg",
                "image/png",
                "image/gif",
                "image/webp"
            ];


            if (in_array($_FILES["imagen"]["type"], $permitidos)) {

                // Nombre nuevo para evitar problemas

                $nombreArchivo = time() . "_" .
                    basename($_FILES["imagen"]["name"]);


                $destino = "uploads/" . $nombreArchivo;


                // Guardar imagen

                if (move_uploaded_file(
                    $_FILES["imagen"]["tmp_name"],
                    $destino
                )) {

                    $rutaImagen = $destino;

                    $subidaCorrecta = true;

                } else {

                    $mensajeError = "Error al subir la imagen.";
                }

            } else {

                $mensajeError = "Solo se permiten imágenes.";

            }
        }
    }


    /*
     * MOSTRAR RESULTADO
     */

    echo "<div class='resultado'>";

    echo "<h2>Datos del Jugador</h2>";


    echo "<p><strong>Nombre:</strong> "
        . $nombre
        . "</p>";


    echo "<p><strong>Alias:</strong> "
        . $alias
        . "</p>";


    echo "<p><strong>Edad:</strong> "
        . $edad
        . "</p>";


    echo "<p><strong>Armas seleccionadas:</strong> ";

    if (count($armas) > 0) {

        echo htmlspecialchars(
            implode(", ", $armas)
        );

    } else {

        echo "Ninguna";
    }

    echo "</p>";


    echo "<p><strong>¿Practica artes mágicas?:</strong> "
        . htmlspecialchars($magia)
        . "</p>";


    echo "<h3>Imagen subida:</h3>";


    // Mostrar imagen

    echo "<img src='$rutaImagen' alt='Imagen del jugador'>";


    /*
     * MOSTRAR ERROR
     */

    if ($mensajeError != "") {

        echo "<p class='error'>"
            . $mensajeError
            . "</p>";

    }


    echo "</div>";


} else {

    /*
     * PETICIÓN GET
     * Mostrar formulario
     */

?>

<div class="contenedor">

    <h1>Formulario de Jugador</h1>

    <form method="POST"
          action="index.php"
